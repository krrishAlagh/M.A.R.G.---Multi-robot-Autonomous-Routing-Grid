# ─── Required ────────────────────────────────────────────────────────────────

# Google Gemini API Key — required for AI chatbot & edge-AI simulation features
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Public URL of this deployment (used for CORS, self-referential links, etc.)
# Cloud Run injects this automatically; set it manually for other platforms.
APP_URL="https://your-service.run.app"

# ─── Optional ────────────────────────────────────────────────────────────────

# Port the Express server listens on (Cloud Run always injects PORT=8080)
# PORT=8080

# Node environment — set to "production" in deployed environments
# NODE_ENV=production

# Strong secret for JWT signing — CHANGE THIS in production!
# JWT_SECRET=your-very-strong-random-secret-here

# CORS allowed origin(s) — defaults to APP_URL in production
# CORS_ORIGIN=https://your-service.run.app

# Enable/disable AMR telemetry simulation (default: true)
# ENABLE_TELEMETRY_SIMULATION=true

# Telemetry broadcast interval in milliseconds (default: 500)
# SIMULATION_INTERVAL_MS=500
